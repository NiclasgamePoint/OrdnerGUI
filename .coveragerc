[run]
branch = True
disable_warnings =
    module-not-imported
    no-data-collected
source =
    app
    main

[report]
# HTTP/process adapters are additionally exercised by the real Docker smoke test.
# Keep a strict repository-wide gate without excluding those modules from metrics.
fail_under = 93
show_missing = True
skip_covered = False
exclude_also =
    if __name__ == ["']__main__["']:
    if self\._shutdown_started:
