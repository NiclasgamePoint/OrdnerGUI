PAPAGUI_SOURCE_PATH=/volume1/Bauvorhaben
PAPAGUI_SERVER_DATA_PATH=/volume1/docker/papagui/data
PAPAGUI_SERVER_CONFIG_PATH=/volume1/docker/papagui/config
PAPAGUI_SOURCE_ID=synology
# Create CONFIG_PATH/api-token and CONFIG_PATH/admin-password-hash as mode 0600
# files before the first start; see docs/server/operations.md. Compose passes only
# their container-local paths, never the secret values, to Docker.
PAPAGUI_API_BIND_ADDRESS=127.0.0.1
PAPAGUI_API_PORT=8765
PAPAGUI_UID=1026
PAPAGUI_GID=100
